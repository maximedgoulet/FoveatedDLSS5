+  if (!ok || ring < 0) {
+    static std::atomic<bool> logged{false};
+    if (!ok && !logged.exchange(true)) {
+      Log(reshade::log::level::warning,
+          "foveated NR: guide pass unavailable; running with the game's guides");
+    }
+    return false;
+  }
